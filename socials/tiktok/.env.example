# Copy to .env. No account needed for public profiles.
# Never commit .env.

# --- Session (optional, private accounts only) --------------------------
TT_SESSIONID=
TT_USER_AGENT=

# --- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
API_KEY=

# --- Politeness ---------------------------------------------------------
TT_MIN_INTERVAL_MS=1000
TT_MAX_PAGES=10
TT_TIMEOUT_MS=15000

# --- Post sources -------------------------------------------------------
# TikTok's item_list API is signed; the SSR profile page has no post list.
# Available: browser (Playwright, opt-in), ssr_itemlist, item_list, video_ids
# TT_POSTS_STRATEGIES=browser,ssr_itemlist,item_list,video_ids
#
# browser = renders the page and captures TikTok's own signed XHRs.
# Install: npm i playwright && npx playwright install chromium
TT_BROWSER=0
TT_BROWSER_WAIT_MS=12000

# --- Optional rotating proxies ------------------------------------------
# Both full URLs and bare user:pass@host:port are accepted.
# TT_PROXY_URL=user:pass@resi.example.su:80
# TT_PROXIES=user:pass@host1:80,user:pass@host2:80
# TT_PROXIES_FILE=/app/proxies.txt
TT_PROXY_ROTATION=round-robin
TT_PROXY_MAX_RETRIES=2
TT_PROXY_COOLDOWN_MS=60000
TT_PROXY_STICKY=1
# TT_PROXY_SESSION=            # {session} placeholder support

# --- Startup proxy check ------------------------------------------------
TT_PROXY_CHECK=1
TT_PROXY_CHECK_CONCURRENCY=5
TT_PROXY_CHECK_TIMEOUT_MS=8000
TT_PROXY_CHECK_COMPARE=1
# TT_PROXY_CHECK_TT_URL=https://www.tiktok.com/@tiktok

# --- Logging / hotkeys --------------------------------------------------
LOG_LEVEL=info
# NO_COLOR=1
# FORCE_COLOR=1
