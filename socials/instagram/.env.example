# Copy this file to .env and fill in at least IG_SESSIONID.
# Never commit .env (it is gitignored).

# --- Instagram session (optional for public posts, needed for private) ---
# Fastest: paste scripts/devtools-session.js into the DevTools console on
# instagram.com; it generates these lines for you. See README > "Getting the
# session cookie".
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=

# User-Agent of the browser that created the cookie. Leave empty for the
# default. IMPORTANT: keep it consistent with the browser, or Instagram
# will raise a checkpoint.
IG_USER_AGENT=

# UA used for anonymous HTML (og:description). Leave empty for "Mozilla/5.0",
# the only one verified to return that tag. Do not use a full browser UA here.
IG_CRAWLER_USER_AGENT=

# --- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Optional: protects YOUR instance if it is exposed. Empty = open access.
API_KEY=

# --- Startup & logging --------------------------------------------------
# Resolve @your_account from the session at boot (current_user, with a
# users/{ds_user_id}/info fallback). Set to 0 to skip and start fully offline.
IG_VERIFY_SESSION=1
IG_VERIFY_TIMEOUT_MS=8000
# debug | info | warn | error | silent
LOG_LEVEL=info
# Colours auto-disable when piping to a file. Override with NO_COLOR=1 or
# FORCE_COLOR=1.
# NO_COLOR=
# FORCE_COLOR=

# --- Politeness / anti-throttling ---------------------------------------
# Minimum delay between two calls to Instagram (ms).
IG_MIN_INTERVAL_MS=1000
# Max number of 12-post pages traversed for a single request.
IG_MAX_PAGES=10
IG_TIMEOUT_MS=15000

# --- Post fetching strategies -------------------------------------------
# Meta retires the posts endpoint regularly. Tried in order until one works;
# GET /v1/diagnostics shows which one answers.
# Available: anon_grid, graphql_posts, web_profile_info_anon,
#            web_profile_info_mobile, web_profile_info
# anon_grid is FIRST and works with NO session and NO proxy.
# IG_POSTS_STRATEGIES=anon_grid,graphql_posts,web_profile_info_anon,web_profile_info_mobile,web_profile_info
#
# PolarisProfilePostsQuery doc_id. If Instagram retires it, set a current one
# here (no code change needed).
# IG_GQL_POSTS_DOC_ID=34579740524958711
# IG_GQL_POSTS_DOC_ID_ANON=37691262543822084
# IG_GQL_ENDPOINT=/graphql/query
# IG_GQL_FRIENDLY_NAME=PolarisProfilePostsQuery
# IG_ASBD_ID=198387
#
# Public posts work without any cookie (anonymous GraphQL doc_id above).
# Set to 0 to require IG_SESSIONID again.
IG_ALLOW_ANONYMOUS_POSTS=1

# --- Logged-out grid (the working anonymous path) -----------------------
# POST /api/graphql. Verified: returns 12 real posts, no cookie, no proxy.
# IG_GQL_API_ENDPOINT=/api/graphql
# IG_GQL_GRID_DOC_ID=27553725110923321        # first page
# IG_GQL_GRID_PAGE_DOC_ID=27389614800735091   # pagination
# IG_GQL_POST_DETAIL_DOC_ID=26713194205046842
# IG_GQL_PROFILE_DOC_ID=27981003384861049   # exact profile counts, anonymous
# IG_GQL_BOOTSTRAP=1   # GET the profile page first for csrftoken / mid

# The grid omits likes / comments / exact time. Set to 1 to fill them with
# one extra anonymous GraphQL call per shortcode (throttled by IG_MIN_INTERVAL_MS).
IG_ENRICH_POSTS=0
IG_ENRICH_MAX=12
#
# Pin ONE exit IP per request. Rotating a logged-in cookie across several IPs
# in a few seconds is a strong anti-bot signal (persistent 429s).
IG_PROXY_STICKY=1

# --- Optional rotating proxies ------------------------------------------
# Leave everything below empty to connect directly (default behaviour).
#
# Single proxy. Both forms work: the full URL, or the bare
# "USERNAME:PASSWORD@HOST:PORT" copied straight from a provider dashboard
# (http:// is added automatically).
# IG_PROXY_URL=http://exampleuser:examplepass@resi.example.su:80
# IG_PROXY_URL=exampleuser:examplepass@resi.example.su:80
IG_PROXY_URL=

# Or a pool, comma-separated (also accepts one URL per line in a file):
# IG_PROXIES=http://u:p@host1:80,http://u:p@host2:80
IG_PROXIES=
# IG_PROXIES_FILE=/app/proxies.txt

# round-robin | random
IG_PROXY_ROTATION=round-robin

# Extra attempts on 429 / network / upstream failures, each through a
# different proxy. 0 disables retries.
IG_PROXY_MAX_RETRIES=2
# How long (ms) a failed proxy is skipped before being eligible again.
IG_PROXY_COOLDOWN_MS=60000

# Sticky residential sessions: put {session} in the URL where your provider
# expects a session id, e.g.
#   http://user-session-{session}:pass@host:port
# IG_PROXY_SESSION pins an explicit id; leaving it empty generates a stable
# per-process id. IG_PROXY_SESSION_TTL_MS rotates it (86400000 = 24h), 0 = never.
IG_PROXY_SESSION=
IG_PROXY_SESSION_TTL_MS=0

# --- Startup proxy health check -----------------------------------------
# Enabled by default when proxies are configured. At boot (and on Ctrl+R)
# each proxy is probed in parallel for: alive, latency (ms) and country code.
IG_PROXY_CHECK=1
# Parallel probes, timeout per probe, and the geo/IP endpoint used.
IG_PROXY_CHECK_CONCURRENCY=5
IG_PROXY_CHECK_TIMEOUT_MS=8000
# Also probe Instagram itself. "alive" against a geo service does NOT mean
# Instagram accepts the IP. Defaults to a stable profile HTML page (the
# retired web_profile_info endpoint would give false 429s).
IG_PROXY_CHECK_IG=1
# IG_PROXY_CHECK_IG_URL=https://www.instagram.com/instagram/
# Browser UA for that probe (defaults to IG_USER_AGENT / a Chrome UA).
# A bot-looking UA alone can trigger 429.
# IG_PROXY_CHECK_IG_UA=
# One extra request WITHOUT the proxy: "IG 0/1 ok (429) · direct 200" means
# Meta rejects the exit IP, not your connection or your cookie.
IG_PROXY_CHECK_IG_COMPARE=1
# Defaults to ipwho.is, then Cloudflare trace, then ipinfo.io. Set to use your
# own endpoint (JSON with country_code, or Cloudflare-style "loc=FR").
# IG_PROXY_CHECK_URL=https://ipwho.is/
# IG_PROXY_CHECK_UA=api-everything/proxy-check/1.0
