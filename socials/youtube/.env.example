# Copy to .env. No Google API key, account, cookie or proxy is needed.
# Never commit .env.

# --- Session (optional; public channels, videos, search & captions are keyless) ---
YT_SESSIONID=
YT_USER_AGENT=
# YT_CONSENT_COOKIES=SOCS=CAISNQgDEitib3FfaWRlbnRpdHlmcm9udGVuZHVpc2VydmVyXzIwMjMwODI5LjA3X3AxGgJlbiACGgYIgJnPpwY; CONSENT=YES+cb.20210328-17-p0.en+FX+410

# --- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
API_KEY=

# --- Politeness & InnerTube locale --------------------------------------
YT_MIN_INTERVAL_MS=500
YT_MAX_PAGES=5
YT_TIMEOUT_MS=15000
YT_HL=en
YT_GL=US
YT_CLIENT_VERSION=2.20241114.01.00

# --- Extraction strategies ----------------------------------------------
# innertube (~25-60 KB JSON) is tried first; html (ytInitialData / ytInitialPlayerResponse) is fallback.
# YT_STRATEGIES=innertube,html
YT_VERIFY_SESSION=1

# --- Optional rotating proxies ------------------------------------------
# Both full URLs and bare user:pass@host:port (plus sticky {session}) are accepted.
# YT_PROXY_URL=user:pass@resi.example.su:80
# YT_PROXIES=user:pass@host1:80,user:pass@host2:80
# YT_PROXIES_FILE=/app/proxies.txt
YT_PROXY_ROTATION=round-robin
YT_PROXY_MAX_RETRIES=2
YT_PROXY_COOLDOWN_MS=60000
YT_PROXY_STICKY=1
# YT_PROXY_SESSION=

# --- Startup proxy check ------------------------------------------------
YT_PROXY_CHECK=1
YT_PROXY_CHECK_CONCURRENCY=5
YT_PROXY_CHECK_TIMEOUT_MS=8000
YT_PROXY_CHECK_COMPARE=1
# YT_PROXY_CHECK_URL=https://ipwho.is/
# YT_PROXY_CHECK_YT_URL=https://www.youtube.com/robots.txt

# --- Logging / hotkeys --------------------------------------------------
LOG_LEVEL=info
# NO_COLOR=1
# FORCE_COLOR=1
