# Copy to .env. No account, cookie or proxy is needed for jobs, companies and signals.
# Never commit .env.

# --- Session (optional; not needed for public sources) -------------------
LI_SESSIONID=
LI_USER_AGENT=
LI_CRAWLER_USER_AGENT=

# --- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
API_KEY=

# --- Politeness ---------------------------------------------------------
LI_MIN_INTERVAL_MS=1000
LI_MAX_PAGES=5
LI_TIMEOUT_MS=15000

# --- Job sources --------------------------------------------------------
# jobs_guest (~30 KB) is preferred; jobs_search_html (~305 KB) is the fallback.
# LI_JOBS_STRATEGIES=jobs_guest,jobs_search_html

# --- Data policy --------------------------------------------------------
# People profiles contain THIRD-PARTY PERSONAL DATA. Disabled by default.
# Enable ONLY on a self-hosted instance. The hosted API Everything service
# does not expose people profiles.
LI_ALLOW_PEOPLE=0

# --- Optional rotating proxies ------------------------------------------
# Both full URLs and bare user:pass@host:port are accepted.
# LI_PROXY_URL=user:pass@resi.example.su:80
# LI_PROXIES=user:pass@host1:80,user:pass@host2:80
# LI_PROXIES_FILE=/app/proxies.txt
LI_PROXY_ROTATION=round-robin
LI_PROXY_MAX_RETRIES=2
LI_PROXY_COOLDOWN_MS=60000
LI_PROXY_STICKY=1
# LI_PROXY_SESSION=

# --- Startup proxy check ------------------------------------------------
LI_PROXY_CHECK=1
LI_PROXY_CHECK_CONCURRENCY=5
LI_PROXY_CHECK_TIMEOUT_MS=8000
LI_PROXY_CHECK_COMPARE=1
# LI_PROXY_CHECK_LI_URL=https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=developer&start=0

# --- Logging / hotkeys --------------------------------------------------
LOG_LEVEL=info
# NO_COLOR=1
# FORCE_COLOR=1
